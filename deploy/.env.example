# Copy to deploy/.env on the VPS and fill in. Never commit the real file.

# ---- Database (Postgres in Docker, source of truth) ----
# Use URL-safe values (letters/digits): they are embedded in DATABASE_URL.
# e.g. POSTGRES_PASSWORD=$(openssl rand -hex 24)
POSTGRES_DB=swarmangal
POSTGRES_USER=swarmangal
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-24

# ---- aaPanel bare-metal path only (not needed for docker-compose, which
# composes this from the POSTGRES_* vars above) ----
# The app itself (src/lib/db.ts) reads this directly and does not use SSL
# unless this URL asks for it — fine for a local Postgres on the same box.
DATABASE_URL=postgresql://swarmangal:<password>@127.0.0.1:5432/swarmangal
# db/apply.mjs (schema + one-time data migrations) is the ONE place that
# defaults to requiring SSL instead of matching the app's own no-SSL
# default — set this or the very first schema apply fails outright with
# "The server does not support SSL connections" against a plain local
# Postgres install (confirmed for real deploying this).
DATABASE_SSL=disable
# The schema needs the pgcrypto extension. On RHEL-family systems (aaPanel
# VPS images are commonly AlmaLinux/CentOS/Rocky, not just Debian/Ubuntu)
# this ships in a separate contrib package the base install doesn't pull
# in — confirmed for real: `dnf install postgresql16-contrib` (match your
# installed major version) before the first `node db/apply.mjs` / app start.

# ---- Public address ----
# Also used to build the parent-facing admission-terms link (brief P10):
# https://<APP_DOMAIN>/terms/<token>. Leave unset and terms tokens still
# work; the app just can't compose a full shareable URL for one.
APP_DOMAIN=api.example.com
APP_PORT=3000

# ---- Device tokens for the Flutter app ----
RPC_FOUNDER_TOKEN=replace-with-openssl-rand-hex-32
RPC_STAFF_TOKEN=replace-with-openssl-rand-hex-32
# Branches the staff token may see. Required: unset means the staff app sees nothing.
RPC_STAFF_BRANCHES=KANDIVALI

# ---- Legacy web logins (min 12 characters; omit to leave them disabled) ----
ADMIN_PASSWORD=
STAFF_PASSWORD=
SESSION_SECRET=replace-with-openssl-rand-hex-32
NEXT_PUBLIC_AUTH_ENABLED=true

# ---- Google Sheets mirror ----
# The id in the mirror workbook URL: docs.google.com/spreadsheets/d/<THIS>/edit
SHEETS_MIRROR_SPREADSHEET_ID=
# The service-account key goes in deploy/secrets/google-service-account.json
SHEETS_SYNC_INTERVAL_MS=5000
SHEETS_SYNC_BATCH=200

# ---- WhatsApp (WA-AKG gateway, runs in this compose file) ----
WA_MYSQL_ROOT_PASSWORD=replace-with-openssl-rand-hex-24
WA_AKG_AUTH_SECRET=replace-with-openssl-rand-hex-32
# Dashboard login (created on first start).
WA_AKG_ADMIN_EMAIL=
WA_AKG_ADMIN_PASSWORD=
WA_AKG_DASHBOARD_PORT=3080
# Reach the dashboard either way:
#  (a) SSH tunnel, no public exposure: `ssh -L 3080:127.0.0.1:3080 root@<vps-ip>`,
#      open http://localhost:3080, and leave WA_AKG_PUBLIC_URL unset.
#  (b) A reverse-proxied hostname (e.g. an nginx site pointing at
#      127.0.0.1:3080 with its own TLS cert): set WA_AKG_PUBLIC_URL to that
#      https:// URL, or the dashboard's own login redirect will bounce you
#      to "localhost" and fail. Recreate the container after changing this
#      (`docker compose up -d wa-akg`, no rebuild needed).
WA_AKG_PUBLIC_URL=
# How THIS APP reaches the gateway's messaging API. If the app runs inside
# this same docker-compose network, leave as http://wa-akg:3000. If the app
# runs on the bare host (e.g. via PM2, per deploy/aapanel/), use
# http://127.0.0.1:<WA_AKG_DASHBOARD_PORT> instead — the gateway's dashboard
# and its /api/messages/... endpoints are the same port.
WA_AKG_BASE_URL=http://wa-akg:3000
# From the WA-AKG dashboard after pairing the academy's number (API Keys / Sessions pages).
WA_AKG_API_KEY=
WA_AKG_SESSION_ID=
# Same secret you type into the WA-AKG webhook form (URL http://app:3000/api/wa/webhook).
WA_WEBHOOK_SECRET=replace-with-openssl-rand-hex-32
# Master switch. Keep false until a test message to your own number works.
WA_SEND_ENABLED=false
# Optional safety net while testing: comma-separated numbers that may receive
# messages (e.g. 9820000000). Empty = every student's registered number.
WA_ALLOWED_NUMBERS=

# ---- Self-service token registration/reset (email + OTP) ----
# The founder's own login email — must match this exactly to register or
# reset the founder's token. Leave unset to use the default (sharvil87@gmail.com).
FOUNDER_EMAIL=
# A Gmail address + App Password (not the normal password — create one at
# myaccount.google.com/apppasswords) works out of the box with the defaults
# below. Leave SMTP_USER/SMTP_PASS empty and the feature refuses cleanly
# ("Email sending is not configured yet") instead of pretending to send.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- Teacher payouts ----
# What a payout percentage is a percentage OF has not been ruled (brief 15.1).
# Leave EMPTY until Sharvil rules: every academy payout then shows a named
# refusal (EARNING_BASE_NOT_DEFINED) instead of an amount. Only known value:
#   COLLECTED_RECEIPTS = fees collected in the month from the teacher's students.
PAYOUT_EARNING_BASE=

# ---- Push notifications (Firebase Cloud Messaging) ----
# Leave EMPTY until you have created a Firebase project — see deploy/README.md
# "Push notifications". The whole feature (registration, sending, the app's
# own request for permission) quietly stays off with this unset; nothing else
# breaks. Once set, restart the app container to pick it up.
#
# The Firebase service account key JSON, either pasted as one line or as its
# base64 encoding (base64 avoids escaping quotes/newlines in a .env file):
#   base64 -w0 service-account.json    (Linux/VPS)
# then paste the single output line here.
FIREBASE_SERVICE_ACCOUNT_JSON=
