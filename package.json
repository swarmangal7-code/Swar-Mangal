{
  "name": "swar-mangal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node -e \"if(process.env.CF_PAGES){require('fs').rmSync('src/app/api',{recursive:true,force:true})}\"",
    "build": "next build",
    "start": "next start",
    "prestart": "node db/apply.mjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "sheets:worker": "node sync/worker.mjs",
    "sheets:status": "node sync/worker.mjs --status",
    "test:backend": "node --experimental-strip-types --test backend-tests/*.test.ts",
    "pages:build": "rm -rf src/app/api && npx @cloudflare/next-on-pages",
    "pages:dev": "npx wrangler pages dev .vercel/output/static --compatibility-flag=nodejs_compat"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.4",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.1.1",
    "@tanstack/react-query": "^5.64.1",
    "@types/three": "^0.186.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "firebase-admin": "^14.4.0",
    "framer-motion": "^12.0.6",
    "google-auth-library": "^9.15.1",
    "lenis": "^1.3.26",
    "lucide-react": "^0.468.0",
    "next": "^15.1.4",
    "next-themes": "^0.4.4",
    "nodemailer": "^10.0.10",
    "pg": "^8.13.1",
    "postprocessing": "^6.39.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.186.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.4",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "@react-three/fiber": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "@cloudflare/workers-types": "^5.20260921.1",
    "sharp": "0.35.4"
  }
}
